@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-card">
    <div class="brand-logo">
        Corporate<span>Asset</span>
        <img src="~/images/logo.svg" alt="Logo" class="logo-icon">
    </div>

    <div class="text-center mb-4">
        <h4 class="fw-bold m-0">Bienvenido de nuevo</h4>
        <p class="text-muted small">Ingresa tus credenciales para acceder</p>
    </div>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label small text-muted">Correo Electrónico o Usuario</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nombre@empresa.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between">
                <label asp-for="Input.Password" class="form-label small text-muted">Contraseña</label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="forgot-password">¿Olvidaste tu contraseña?</a>
            </div>
            <div class="input-group password-field">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="Input.Password" type="password" id="passwordInput" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <i class="bi bi-eye toggle-password" id="togglePasswordIcon"></i>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-4 form-check">
            <input asp-for="Input.RememberMe" type="checkbox" class="form-check-input" id="rememberMe" />
            <label asp-for="Input.RememberMe" class="form-check-label small text-muted" for="rememberMe">Mantener sesión iniciada</label>
        </div>

        <button type="submit" id="login-submit" class="btn btn-login w-100">
            Iniciar Sesión <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </form>

    <div class="text-center mt-4">
        <p class="small text-muted">¿No tienes cuenta? <a asp-page="./Register" class="forgot-password fw-bold">Regístrate aquí</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}